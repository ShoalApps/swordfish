         A debug-signed app cannot redeclare it alongside them. -->
    <permission android:name="io.github.shoalapps.permission.MOVE_DATA" tools:node="remove" />
    <application>
        <activity android:name=".ForegroundTestActivity" android:exported="false" />
    </application>
</manifest>
