<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <color name="window_bg">#FFFFF8F7</color>
    
    <style name="Theme.Tube" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_bg</item>
        <item name="android:windowSplashScreenBackground" tools:targetApi="31">@color/window_bg</item>
        <item name="android:windowSplashScreenIconBackgroundColor" tools:targetApi="31">@color/icon_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- TV mode: black, edge to edge, before YouTube's TV app draws. -->
    <style name="Theme.Tube.Tv" parent="Theme.Tube">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowLayoutInDisplayCutoutMode" tools:targetApi="28">shortEdges</item>
    </style>
</resources>
