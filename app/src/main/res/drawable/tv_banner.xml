<?xml version="1.0" encoding="utf-8"?>
<!-- Android TV launcher banner (16:9): the app icon on the brand colour. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="320dp" android:height="180dp">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/icon_bg" />
        </shape>
    </item>
    <item android:drawable="@drawable/ic_launcher_foreground"
        android:width="180dp" android:height="180dp" android:gravity="center" />
</layer-list>
